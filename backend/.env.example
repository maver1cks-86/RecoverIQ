# Required for the local core demo
DATABASE_URL=postgresql://recoveriq:recoveriq@localhost:5433/recoveriq
REDIS_URL=redis://localhost:6379/0

# Required only for Razorpay Test Mode execution
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_mode_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_MODE=test

# Optional: Recovery Copilot and What-if interpretation
LLM_API_KEY=your_optional_llm_api_key
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
